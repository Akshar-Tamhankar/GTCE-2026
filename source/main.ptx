  <!-- Common macros, latex-image preamble, etc. -->
  <xi:include href="./docinfo.ptx" />

  <book>
    <title>MATH 1554 Linear Algebra</title>
    <subtitle>Distance Math Studio Worksheets</subtitle>

    <xi:include href="./frontmatter.ptx" />

    <chapter xml:id="course-documents">
      <title>Course Documents</title>

      <xi:include href="./syllabus/syllabus.ptx" />
    </chapter>

    <chapter xml:id="course-notes">
      <title>Course Notes</title>

      <introduction>
        <p>
          The following notes are intended to remind you what we covered each week.
          They are not a substitute for attending class and not a substitute for
          reading the textbook.
        </p>
      </introduction>

      <xi:include href="./notes/week01.ptx"/>
      <xi:include href="./notes/week02.ptx"/>
    </chapter>

    <chapter xml:id="worksheets">
      <title>Studio Worksheets</title>

      <introduction>
        <p>
          These are the studio worksheets distributed during the semester. Work
          through them yourself, and bring questions to office hours or the
          course forums.
        </p>
      </introduction>

      <!-- Add one xi:include per worksheet, in order. -->
      <xi:include href="./wkst-24.ptx"/>
    </chapter>

    <chapter xml:id="activities">
      <title>In-Class Activities</title>

      <introduction>
        <p>
          These are copies of the in-class activities distributed during the semester.
        </p>
      </introduction>

      <xi:include href="./activities/01-intro-activity.ptx"/>
    </chapter>

    <!-- A <chapter> must contain real content: a chapter holding only a       -->
    <!-- <title> fails schema validation.  Keep these commented out until      -->
    <!-- there is something to include, then uncomment chapter and includes.   -->
